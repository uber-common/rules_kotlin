load("@rules_java//java:defs.bzl", "java_plugin")
load("//kotlin:core.bzl", "define_kt_toolchain")
load("//kotlin:jvm.bzl", "kt_jvm_library")
load(":kaptish_test.bzl", "kaptish_generated_sources_test")

define_kt_toolchain(
    name = "kaptish_toolchain",
    experimental_kaptish_enabled = True,
)

java_plugin(
    name = "autovalue_plugin",
    generates_api = 1,
    processor_class = "com.google.auto.value.processor.AutoValueProcessor",
    deps = ["@kotlin_rules_maven//:com_google_auto_value_auto_value"],
)

kt_jvm_library(
    name = "kaptish_test_lib",
    srcs = [
        "AutoValueJavaModel.java",
        "KaptishMarker.kt",
    ],
    plugins = [":autovalue_plugin"],
    deps = ["@kotlin_rules_maven//:com_google_auto_value_auto_value_annotations"],
)

kaptish_generated_sources_test(
    name = "kaptish_generated_sources_test",
    target_under_test = ":kaptish_test_lib",
)

test_suite(
    name = "kaptish_tests",
    tests = [":kaptish_generated_sources_test"],
)
